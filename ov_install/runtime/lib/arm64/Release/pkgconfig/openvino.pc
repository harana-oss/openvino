pc_path=${pcfiledir}
prefix=${pc_path}/../../../../../

exec_prefix=${prefix}/runtime/lib/arm64/Release
libdir=${exec_prefix}

include_prefix=${prefix}/runtime/include
includedir=${include_prefix}

Name: OpenVINO
Description: OpenVINO™ Toolkit
URL: https://docs.openvino.ai/latest/index.html
Version: 2025.4.0
Conflicts: openvino < 2025.4.0
Cflags: -I${includedir}  -DOV_THREAD=OV_THREAD_TBB
Libs: -L${libdir} -lopenvino_jax_frontend -lopenvino_onnx_frontend -lopenvino_paddle_frontend -lopenvino_pytorch_frontend -lopenvino_tensorflow_frontend -lopenvino_tensorflow_lite_frontend -lopenvino_c -lopenvino -L${prefix}/runtime/3rdparty/tbb/lib -ltbb
Libs.private: -ldl -lm -lpthread -lrt
